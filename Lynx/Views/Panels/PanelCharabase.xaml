<UserControl x:Class="Lynx.Views.Panels.PanelCharabase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Lynx.ViewModels.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:PanelCharabaseViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: ListView -->
        <Border Grid.Column="0" 
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <Border Grid.Row="0" Style="{StaticResource SearchBarStyle}" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" 
                                 Grid.Column="0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="SearchTextBox_GotFocus"
                                 LostFocus="SearchTextBox_LostFocus"/>

                        <Button Grid.Column="1" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Width="20" 
                                Height="20"
                                Margin="0,0,5,0">
                            <TextBlock Text="🔍" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ListView with Grouping -->
                <ListView x:Name="CharabaseListView"
                          Grid.Row="1"
                          Style="{StaticResource ImaginationListView}"
                          ItemsSource="{Binding CharabaseListView}"
                          SelectedItem="{Binding SelectedCharabaseItem}"
                          MouseDoubleClick="CharabaseListView_MouseDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="False"
                                                          BorderThickness="0"
                                                          Margin="0,2">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" 
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                                       Margin="5,2"/>
                                                            <TextBlock Text=" (" 
                                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                                       Margin="2,2,0,2"/>
                                                            <TextBlock Text="{Binding ItemCount}" 
                                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                                       Margin="0,2"/>
                                                            <TextBlock Text=")" 
                                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                                       Margin="0,2,2,2"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Expander.Content>
                                                        <ScrollViewer MaxHeight="400" 
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      Margin="10,5,0,5">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </Expander.Content>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" 
                                       Margin="20,2,5,2"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Right Panel: Character Details -->
        <Border Grid.Column="1" 
                Style="{StaticResource PanelBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10" IsEnabled="{Binding IsCharacterSelected}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Section: Image + Hash/Fullname/Nickname -->
                    <Grid Grid.Row="0" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Character Image -->
                        <Border Grid.Column="0"
                                Width="128"
                                Height="128"
                                VerticalAlignment="Top"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Image Source="{Binding CharacterFaceImage}" 
                                   Stretch="Uniform"/>
                        </Border>

                        <!-- Hash, Fullname, Nickname -->
                        <Grid Grid.Column="2" Margin="0,3,0,-3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hash -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Hash"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,7,0,0"/>

                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Height="35"
                                    Margin="0,2"
                                    Padding="5,0">
                                <TextBox Text="{Binding SelectedCharacterHash, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         IsReadOnly="True"/>
                            </Border>

                            <!-- Full Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="Fullname"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,7,0,0"/>

                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding SelectedCharacterFullName}"
                                        Command="{Binding EditFullNameCommand}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2"
                                        Height="35">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="Edit with Nyanko"
                                        Command="{Binding EditWithNyankoCommand}"
                                        Height="35"
                                        Margin="0,2"
                                        Padding="10,0"
                                        Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                        BorderBrush="{DynamicResource Theme.Border.Brush}"
                                        Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                        BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Nickname -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Nickname"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,7,0,0"/>

                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding SelectedCharacterNickname}"
                                        Command="{Binding EditNicknameCommand}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2"
                                        Height="35">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="Edit with Nyanko"
                                        Command="{Binding EditWithNyankoCommand}"
                                        Height="35"
                                        Margin="0,2"
                                        Padding="10,0"
                                        Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                        BorderBrush="{DynamicResource Theme.Border.Brush}"
                                        Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                        BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Character Details -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Labels"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Year -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="Year"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Border Grid.Row="0" Grid.Column="2"
                                Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="35"
                                Margin="0,2">
                            <ComboBox Style="{StaticResource ImaginationComboBox}"
                                      ItemsSource="{Binding Years}"
                                      SelectedIndex="{Binding SelectedYear}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                        </Border>

                        <!-- Model -->
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                   Text="Model"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Border Grid.Row="1" Grid.Column="2"
                                Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="35"
                                Margin="0,2">
                            <ComboBox Style="{StaticResource ImaginationComboBox}"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                        </Border>

                        <!-- Model Type -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                   Text="Model Type"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Border Grid.Row="2" Grid.Column="2"
                                Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="35"
                                Margin="0,2">
                            <ComboBox Style="{StaticResource ImaginationComboBox}"
                                      ItemsSource="{Binding CharaTypes}"
                                      SelectedIndex="{Binding SelectedCharaType}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                        </Border>

                        <!-- Skin -->
                        <TextBlock Grid.Row="3" Grid.Column="0" 
                                   Text="Skin"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Grid Grid.Row="3" Grid.Column="2" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Height="35">
                                <ComboBox Style="{StaticResource ImaginationComboBox}"
                                          ItemsSource="{Binding Skins}"
                                          SelectedIndex="{Binding SelectedSkin}"
                                          Background="Transparent"
                                          BorderThickness="0"/>
                            </Border>

                            <Border Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="3"
                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                    BorderThickness="1"
                                    Background="{Binding SkinColor}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Body Type -->
                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                   Text="Body Type"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Border Grid.Row="4" Grid.Column="2"
                                Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="35"
                                Margin="0,2">
                            <ComboBox Style="{StaticResource ImaginationComboBox}"
                                      ItemsSource="{Binding Bodies}"
                                      SelectedIndex="{Binding SelectedBody}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                        </Border>

                        <!-- Gender -->
                        <TextBlock Grid.Row="5" Grid.Column="0" 
                                   Text="Gender"
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,7,0,0"/>

                        <Border Grid.Row="5" Grid.Column="2"
                                Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="35"
                                Margin="0,2">
                            <ComboBox Style="{StaticResource ImaginationComboBox}"
                                      ItemsSource="{Binding Genders}"
                                      SelectedIndex="{Binding SelectedGender}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                        </Border>

                        <!-- Palpack Des. -->
                        <TextBlock Grid.Row="6" Grid.Column="0" 
                                   Text="Palpack Des."
                                   Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Top"
                                   Margin="5,12,0,0"/>

                        <Grid Grid.Row="6" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="{Binding SelectedCharacterDescription}"
                                    Command="{Binding EditDescriptionCommand}"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Top"
                                    Margin="0,2"
                                    Height="70">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="5,5">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                       VerticalAlignment="Top"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2"
                                    Content="Edit with Nyanko"
                                    Command="{Binding EditWithNyankoCommand}"
                                    Height="72"
                                    VerticalAlignment="Center"
                                    Padding="10,0"
                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                    Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                    BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="0"
                      Style="{StaticResource ImaginationGridSplitter}"/>
    </Grid>
</UserControl>