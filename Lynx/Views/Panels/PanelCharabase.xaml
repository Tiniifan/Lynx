<UserControl x:Class="Lynx.Views.Panels.PanelCharabase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Lynx.ViewModels.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:PanelCharabaseViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: TreeView -->
        <Border Grid.Column="0" 
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Row="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ImaginationTextBox}"
                         Margin="5"
                         Height="30"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Brush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Background" Value="{DynamicResource Theme.Control.BackgroundBrush}"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- TreeView -->
                <TreeView Grid.Row="1"
                          x:Name="CharabaseTreeView"
                          Style="{StaticResource ModernTreeViewStyle}"
                          ItemContainerStyle="{StaticResource ImaginationTreeViewItem}"
                          ItemsSource="{Binding CharabaseTree}"
                          SelectedItemChanged="CharabaseTreeView_SelectedItemChanged"
                          MouseDoubleClick="CharabaseTreeView_MouseDoubleClick">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type viewmodels:CharabaseTreeNode}" 
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu Style="{StaticResource Theme.AcrylicContextMenuStyle}">
                            <MenuItem Header="Insert" 
                                      Command="{Binding InsertCharabaseCommand}"
                                      Style="{StaticResource Theme.ContextMenu.MenuItemStyle}"/>
                            <MenuItem Header="Delete" 
                                      Command="{Binding DeleteCharabaseCommand}"
                                      Style="{StaticResource Theme.ContextMenu.MenuItemStyle}"/>
                            <Separator Style="{StaticResource Theme.ContextMenu.SeparatorStyle}"/>
                            <MenuItem Header="Export as .cfg.bin" 
                                      Command="{Binding ExportAsCfgBinCommand}"
                                      Style="{StaticResource Theme.ContextMenu.MenuItemStyle}"/>
                            <MenuItem Header="Export as .csv" 
                                      Command="{Binding ExportAsCsvCommand}"
                                      Style="{StaticResource Theme.ContextMenu.MenuItemStyle}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>
        </Border>

        <!-- Right Panel: Character Details -->
        <Border Grid.Column="1" 
                Style="{StaticResource PanelBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10" IsEnabled="{Binding IsCharacterSelected}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Character Image -->
                    <Border Grid.Row="0"
                            Width="128"
                            Height="128"
                            HorizontalAlignment="Left"
                            Margin="10"
                            BorderBrush="{DynamicResource Theme.Border.Brush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Image Source="{Binding CharacterFaceImage}" 
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Character Details -->
                    <StackPanel Grid.Row="1" Margin="10">
                        <!-- Hash -->
                        <TextBox Text="{Binding SelectedCharacterHash, Mode=OneWay}"
                                 Tag="Hash"
                                 Style="{StaticResource ImaginationLabeledTextBox}"
                                 IsReadOnly="True"/>

                        <!-- Full Name -->
                        <Button Content="{Binding SelectedCharacterFullName}"
                                Command="{Binding EditFullNameCommand}"
                                HorizontalContentAlignment="Left"
                                Margin="0,2"
                                Height="35">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Theme.Control.BackgroundBrush}"
                                            BorderBrush="{DynamicResource Theme.Border.Brush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid Margin="5,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="Fullname"
                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nickname -->
                        <Button Content="{Binding SelectedCharacterNickname}"
                                Command="{Binding EditNicknameCommand}"
                                HorizontalContentAlignment="Left"
                                Margin="0,2"
                                Height="35">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Theme.Control.BackgroundBrush}"
                                            BorderBrush="{DynamicResource Theme.Border.Brush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid Margin="5,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="Nickname"
                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Year -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Year"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,0"/>

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding Years}"
                                      SelectedIndex="{Binding SelectedYear}"/>
                        </Grid>

                        <!-- Model Type -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Model"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,0"/>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding SelectedModel}"/>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding CharaTypes}"
                                          SelectedIndex="{Binding SelectedCharaType}"/>
                            </Grid>
                        </Grid>

                        <!-- Skin -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Skin"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,0"/>

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding Skins}"
                                      SelectedIndex="{Binding SelectedSkin}"/>

                            <Border Grid.Column="4"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="3"
                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                    BorderThickness="1"
                                    Background="{Binding SkinColor}"/>
                        </Grid>

                        <!-- Body Type -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Body Type"
                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="5,0"/>

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding Bodies}"
                                      SelectedIndex="{Binding SelectedBody}"/>

                            <ComboBox Grid.Column="4"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding Genders}"
                                      SelectedIndex="{Binding SelectedGender}"/>
                        </Grid>

                        <!-- Description -->
                        <Button Content="{Binding SelectedCharacterDescription}"
                                Command="{Binding EditDescriptionCommand}"
                                HorizontalContentAlignment="Left"
                                Margin="0,2"
                                Height="35">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Theme.Control.BackgroundBrush}"
                                            BorderBrush="{DynamicResource Theme.Border.Brush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid Margin="5,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="Palpack Des."
                                                       Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Theme.TitleBar.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Theme.Border.Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{DynamicResource Theme.Text.PrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="0"
                      Style="{StaticResource ImaginationGridSplitter}"/>
    </Grid>
</UserControl>